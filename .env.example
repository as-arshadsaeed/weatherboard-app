# GeoDB Cities (RapidAPI) key for city autocomplete — used from Phase 3.
# WARNING: VITE_* variables are bundled into the public JS. Treat this key as
# public: restrict it by domain and set a quota in the RapidAPI dashboard.
# If left empty, the app falls back to the keyless Open-Meteo geocoding API.
VITE_GEODB_API_KEY=
